{
    "name": "charlescorrea/dexter-framework",
    "description": "Framework PHP 8.4+ moderno, modular, seguro por padrão e baseado no padrão MVC para aplicações web, APIs e datalakes.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Charles Corrêa",
            "email": "charlescorreaweb@gmail.com",
            "role": "Creator & Lead Architect"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6",
        "php-di/php-di": "^7.0",
        "twig/twig": "^3.14",
        "phpmailer/phpmailer": "^6.9",
        "predis/predis": "^2.2",
        "phpfastcache/phpfastcache": "^9.2",
        "league/oauth2-client": "^2.7",
        "league/oauth2-google": "^4.0",
        "stevenmaguire/oauth2-microsoft": "^2.2",
        "thenetworg/oauth2-azure": "^2.2",
        "vertisan/oauth2-twitch-helix": "^2.0",
        "wohali/oauth2-discord-new": "^1.2",
        "league/oauth2-linkedin": "^5.1",
        "bepsvpt/secure-headers": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "mockery/mockery": "^1.6",
        "filp/whoops": "^2.16",
        "php-debugbar/php-debugbar": "^1.23",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Dexter\\": "core/",
            "Dexter\\App\\": "app/",
            "Dexter\\Backend\\": "backend/",
            "Dexter\\Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dexter\\Testes\\": "testes/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --level=8 core backend app",
        "cs": "phpcs --standard=PSR12 core backend app",
        "cs-fix": "phpcbf --standard=PSR12 core backend app"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
