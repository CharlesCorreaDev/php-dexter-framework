# Configurações Gerais da Aplicação
APP_NAME="Dexter Framework"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_SECRET=sua-chave-secreta-de-64-caracteres-hex-para-criptografia-e-sessoes

# Banco de Dados Principal (Database-Manager.php)
# Drivers suportados: pgsql, mysql, firebird, sqlsrv, sqlite, mongodb
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dexter_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TIMEZONE=-03:00

# Conexão Secundária (Exemplo Firebird / Legado)
DB_FIREBIRD_HOST=127.0.0.1
DB_FIREBIRD_PORT=3050
DB_FIREBIRD_DATABASE=/caminho/para/base.fdb
DB_FIREBIRD_USERNAME=SYSDBA
DB_FIREBIRD_PASSWORD=masterkey
DB_FIREBIRD_CHARSET=UTF8

# Conexão Secundária (Exemplo PostgreSQL / Datalake)
DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=dexter_datalake
DB_PGSQL_USERNAME=postgres
DB_PGSQL_PASSWORD=

# Cache & Sessões
# Drivers suportados: valkey, redis, file, apcu, memcached, dragonfly
CACHE_DRIVER=file
CACHE_PREFIX=dexter_cache_
CACHE_TTL=3600

# Valkey / Redis (Filas Dark Passenger & Cache)
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DATABASE=0

# Fila e Tarefas (The Dark Passenger)
# Drivers suportados: valkey, redis, rabbitmq, sync
QUEUE_CONNECTION=sync

# RabbitMQ (Opcional)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# E-mail Transacional (PHPMailer)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@dexter.local"
MAIL_FROM_NAME="Dexter Framework"

# Autenticação Administrativa OAuth 2.0 / OpenID Connect
# Provedores: google, microsoft, microsoft-365, twitch, discord, linkedin
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI="${APP_URL}/admin/auth/callback/google"

OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URI="${APP_URL}/admin/auth/callback/microsoft"

OAUTH_M365_ENABLED=false
OAUTH_M365_TENANT_ID=common
OAUTH_M365_CLIENT_ID=
OAUTH_M365_CLIENT_SECRET=
OAUTH_M365_REDIRECT_URI="${APP_URL}/admin/auth/callback/microsoft-365"

OAUTH_TWITCH_ENABLED=false
OAUTH_TWITCH_CLIENT_ID=
OAUTH_TWITCH_CLIENT_SECRET=
OAUTH_TWITCH_REDIRECT_URI="${APP_URL}/admin/auth/callback/twitch"

OAUTH_DISCORD_ENABLED=false
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_REDIRECT_URI="${APP_URL}/admin/auth/callback/discord"

OAUTH_LINKEDIN_ENABLED=false
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_REDIRECT_URI="${APP_URL}/admin/auth/callback/linkedin"

# Segurança e Perímetro (The Code / GuardaIP)
SECURITY_BLOCK_UNKNOWN_BOTS=true
SECURITY_RATE_LIMIT_LOGIN_MAX=5
SECURITY_RATE_LIMIT_LOGIN_WINDOW=60
STOP_FORUM_SPAM_ENABLED=false
STOP_FORUM_SPAM_API_KEY=

